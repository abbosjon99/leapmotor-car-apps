<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.migu.car.music">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <queries>
        <!-- so MusicGate can see whether DiPlay is installed -->
        <package android:name="com.shihab.diplay"/>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
    </queries>
    <application android:appCategory="audio" android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false">
        <!-- the launcher entry (app-list icon and the car's dock-card tap): the home screen with the now-playing widget -->
        <activity android:name="uz.carhelper.passenger.MusicHomeActivity" android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- opened from the home screen's Settings button; exported so it can also be started with adb -->
        <activity android:name="uz.carhelper.passenger.MusicSettingsActivity" android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
        <!-- the car launches Migu with this action ("open app", source switch): open the playing player instead -->
        <activity android:name="uz.carhelper.passenger.OpenPlayerActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.migu.car.music.ACTION_START"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- no MediaBrowserService intent-filter: Android's car media service picks any playing browser service
             as the media source and then pauses the real player (FINDINGS.md section 9) -->
        <service android:name="uz.carhelper.passenger.MediaBrowser" android:exported="false"/>
        <!-- MultiMedia binds this (ComponentName com.migu.car.music / com.migu.car.music.launcher.SourceService)
             before it answers the dock's favourite lookup; see FINDINGS.md section 4 -->
        <service android:name="com.migu.car.music.launcher.SourceService" android:exported="true"/>
        <!-- the dock card loads the announced cover (MediaBody.imagUrl) from here; see CoverProvider -->
        <provider android:name="uz.carhelper.passenger.CoverProvider" android:authorities="com.migu.car.music.cover"
            android:exported="true"/>
        <service android:name="uz.carhelper.passenger.WheelListener" android:exported="true"
            android:label="LP Music wheel buttons"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <receiver android:name="uz.carhelper.passenger.MiguCtrlReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.leapmotor.action.METER.CTRL"/>
                <action android:name="com.leapmotor.action.VOICE.CTRL"/>
            </intent-filter>
        </receiver>
        <receiver android:name="uz.carhelper.passenger.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <!-- the car's own boot broadcasts (MultiMedia / Migu register for these too) -->
                <action android:name="com.leapmotor.action.BOOT_COMPLETED"/>
                <action android:name="com.leapmotoraction.BOOT_COMPLETED"/>
                <!-- head-unit "quick boot" (wake from deep sleep) -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
